# ---- Backend (backend/.env) ----
PORT=5000
MONGODB_URI=
CORS_ORIGIN=http://localhost:5173
MAX_SAMPLE_RECORDS=100
# AI provider: openai | gemini | mock  (mock = offline deterministic planner, no API key needed)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=60000

# ---- Frontend (frontend/.env) ----
VITE_API_URL=http://localhost:5000
